# Telegram
TG_BOT_TOKEN=123456:AA...              # токен бота от @BotFather

# Прочее
ALBUM_COLLECT_DELAY=1.5                # сек, сколько ждать все фото альбома перед постингом
STORAGE_PATH=data/storage.json         # тут хранятся VK-токены юзеров и привязки каналов, не коммитить

# VK-группы и каналы больше не настраиваются тут - каждый юзер добавляет их сам через диалог с ботом (/start).
