# Telegram
# токен бота от @BotFather
TG_BOT_TOKEN=123456:AA...

# ID standalone-приложения VK (публичный, секретный ключ не нужен)
VK_CLIENT_ID=54719871

# Прочее
# сек, сколько ждать все фото альбома перед постингом
ALBUM_COLLECT_DELAY=1.5
# тут хранятся VK-токены юзеров и привязки каналов, не коммитить
STORAGE_PATH=data/storage.json

# VK-группы и каналы больше не настраиваются тут - каждый юзер добавляет их сам через диалог с ботом (/start).
